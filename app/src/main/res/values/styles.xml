<?xml version="1.0" encoding="utf-8"?>
<!-- Controls the app-wide Android theme, fonts, and system bar colors. -->
<resources>
    <style name="Theme.PokeVault" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/vault_red</item>
        <item name="android:navigationBarColor">@color/vault_dark</item>
        <item name="android:statusBarColor">@color/vault_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
