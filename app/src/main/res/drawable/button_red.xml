    <item>
        <shape>
            <solid android:color="@color/vault_red" />
            <corners android:radius="8dp" />
            <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
