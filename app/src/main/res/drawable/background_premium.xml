<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base cream -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFF9EC"
                android:centerColor="#FFF4DC"
                android:endColor="#F6E3B7" />
        </shape>
    </item>

    <!-- Soft top glow -->
    <item
        android:left="210dp"
        android:bottom="610dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:centerColor="#22F3CF68"
                android:endColor="#00F3CF68" />
        </shape>
    </item>

    <!-- Soft bottom glow -->
    <item
        android:right="230dp"
        android:top="650dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:centerColor="#18D6A820"
                android:endColor="#00D6A820" />
        </shape>
    </item>

    <!-- Very faint diagonal sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#10FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#0CFFFFFF" />
        </shape>
    </item>

</layer-list>