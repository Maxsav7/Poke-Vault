<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main card -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <corners android:radius="20dp" />

            <stroke
                android:width="1dp"
                android:color="#D9C58A" />

        </shape>
    </item>

    <!-- Gold collector strip -->
    <item
        android:right="330dp"
        android:top="18dp"
        android:bottom="18dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="270"
                android:startColor="#A97800"
                android:centerColor="#F1D36E"
                android:endColor="#A97800" />

            <corners
                android:topLeftRadius="20dp"
                android:bottomLeftRadius="20dp" />

        </shape>

    </item>

</layer-list>