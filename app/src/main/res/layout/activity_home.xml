<?xml version="1.0" encoding="utf-8"?>
<!-- HOME SCREEN: Existing IDs preserved for Java compatibility. -->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_premium"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- Header -->

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:text="Welcome back"
            android:textColor="@color/vault_dark"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/nunito_sans_regular"
            android:text="Manage your personal Pokémon collection."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <View
            android:layout_width="54dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/gold_accent" />

        <!-- Collection overview -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/panel"
            android:elevation="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:text="Collection Overview"
                android:textColor="@color/vault_dark"
                android:textSize="21sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/nunito_sans_regular"
                android:text="A quick look at your vault."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/summaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/nunito_sans_regular"
                android:lineSpacingExtra="8dp"
                android:text="Cards Owned: 0&#10;Collection Value: $0.00"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <Button
                android:id="@+id/catalogButton"
                android:layout_width="240dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:background="@drawable/button_red"
                android:backgroundTint="@null"
                android:elevation="2dp"
                android:fontFamily="@font/poppins_semibold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Browse Cards"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Quick access heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:text="Quick Access"
            android:textColor="@color/vault_dark"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_sans_regular"
            android:text="Jump back into your collection."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Vault row -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/stat_tile"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:text="My Vault"
                    android:textColor="@color/vault_dark"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito_sans_regular"
                    android:text="View your saved cards and total value."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/vaultButton"
                android:layout_width="92dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="@font/poppins_semibold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Open"
                android:textAllCaps="false"
                android:textColor="@color/vault_dark"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Profile row -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/stat_tile"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:text="Trainer Profile"
                    android:textColor="@color/vault_dark"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/nunito_sans_regular"
                    android:text="Review your collector information."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/profileButton"
                android:layout_width="92dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/button_outline_navy"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:fontFamily="@font/poppins_semibold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="View"
                android:textAllCaps="false"
                android:textColor="@color/vault_dark"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Logout -->

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="180dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/nunito_sans_regular"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="Log Out"
            android:textAllCaps="false"
            android:textColor="@color/vault_red"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>