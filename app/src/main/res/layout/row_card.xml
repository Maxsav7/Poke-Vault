<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cardImage"
            android:layout_width="92dp"
            android:layout_height="128dp"
            android:adjustViewBounds="true"
            android:background="@drawable/stat_tile"
            android:contentDescription="Pokemon card image"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cardNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="2"
                android:text="Card Name"
                android:textColor="@color/vault_dark"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/cardInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/nunito_sans_regular"
                android:text="Base Set card details"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/cardConditionSpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_field"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cardMinusButton"
            android:layout_width="52dp"
            android:layout_height="42dp"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:text="−"
            android:textColor="@color/vault_dark"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/cardQuantityText"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/vault_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cardPlusButton"
            android:layout_width="52dp"
            android:layout_height="42dp"
            android:background="@drawable/button_red"
            android:backgroundTint="@null"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="20sp" />

    </LinearLayout>

    <Button
        android:id="@+id/cardActionButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/button_outline_navy"
        android:backgroundTint="@null"
        android:text="Remove Card"
        android:textAllCaps="false"
        android:textColor="@color/vault_dark"
        android:visibility="gone" />

</LinearLayout>
