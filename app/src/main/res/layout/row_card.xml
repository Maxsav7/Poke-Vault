<?xml version="1.0" encoding="utf-8"?>
<!-- CARD ROW: Reused for each card shown in the catalog and vault lists. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel"
    android:orientation="vertical">

    <TextView
        android:id="@+id/cardNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/vault_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cardInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp" />

    <Button
        android:id="@+id/cardActionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Add to Vault" />
</LinearLayout>
