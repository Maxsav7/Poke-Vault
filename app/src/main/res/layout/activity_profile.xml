<?xml version="1.0" encoding="utf-8"?>
<!-- PROFILE SCREEN: Existing IDs preserved for Java compatibility. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_premium"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="46dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:includeFontPadding="false"
        android:text="Trainer Profile"
        android:textColor="@color/vault_dark"
        android:textSize="30sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/nunito_sans_regular"
        android:text="Your collector identity"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <View
        android:layout_width="366dp"
        android:layout_height="5dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/gold_accent" />

    <!-- Trainer Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/panel"
        android:elevation="5dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Avatar -->
        <TextView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/stat_tile"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="PV"
            android:textColor="@color/vault_red"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Collector"
            android:textColor="@color/vault_dark"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_sans_regular"
            android:text="PokéVault Member"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/profileDetailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/nunito_sans_regular"
            android:lineSpacingExtra="8dp"
            android:text="Username\nCollection Value\nCards Owned"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Achievement Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/panel"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Collector Status"
            android:textColor="@color/vault_dark"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/nunito_sans_regular"
            android:lineSpacingExtra="2dp"
            android:text="Continue growing your collection by discovering and saving more Pokémon cards."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Back -->
    <Button
        android:id="@+id/profileBackButton"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/button_outline_navy"
        android:backgroundTint="@null"
        android:elevation="1dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Back to Dashboard"
        android:textAllCaps="false"
        android:textColor="@color/vault_dark"
        android:textSize="15sp" />

</LinearLayout>